<Window
    x:Class="BrowserPicker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BrowserPicker"
    Title="BrowserPicker">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
        </Grid.RowDefinitions>

        <!-- Drag region (caption buttons area) -->
        <Border x:Name="TitleBarArea" Grid.Row="0" Background="Transparent" />

        <!-- Header: "Abrir com" + URL -->
        <StackPanel Grid.Row="1" Padding="20,0,20,16">
            <TextBlock Text="Abrir com"
                       FontSize="20"
                       FontWeight="SemiBold" />
            <TextBlock x:Name="UrlPreview"
                       FontSize="12"
                       Opacity="0.55"
                       TextTrimming="CharacterEllipsis"
                       MaxLines="1"
                       Margin="0,3,0,0" />
        </StackPanel>

        <!-- Banner: BrowserPicker não é o browser padrão -->
        <Border x:Name="NotDefaultBanner"
                Grid.Row="2"
                Visibility="Collapsed"
                Background="#33FFA500"
                Padding="16,10"
                Margin="12,0,12,12"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="⚠  BrowserPicker não está definido como browser padrão"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <HyperlinkButton Content="Definir como padrão"
                                 Click="SetDefaultButton_Click"
                                 Padding="4,0" />
            </StackPanel>
        </Border>

        <!-- Browser list -->
        <ListView x:Name="BrowserList"
                  Grid.Row="3"
                  Padding="8,0"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="BrowserList_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:BrowserItem">
                    <Grid Height="56"
                          ToolTipService.ToolTip="{x:Bind ToolTipText, Mode=OneTime}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Width="36" Height="36"
                               VerticalAlignment="Center"
                               Source="{x:Bind Icon, Mode=OneWay}" />
                        <TextBlock Grid.Column="1"
                                   Text="{x:Bind Name, Mode=OneTime}"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Margin="4,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Window>
